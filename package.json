{
  "name": "shiftlush-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:generate": "openapi-typescript openapi/v1.yaml -o src/api/generated.ts",
    "api:sync": "node scripts/sync-contract.mjs",
    "lint:contract": "node scripts/check-contract-fresh.mjs",
    "lint:tr": "node scripts/check-no-turkish.mjs",
    "lint:i18n": "node scripts/check-i18n-keys.mjs",
    "lint:errors": "node scripts/check-error-codes.mjs",
    "lint:paths": "node scripts/check-api-paths.mjs",
    "lint:password": "node scripts/check-password-length.mjs",
    "lint:buttons": "node scripts/check-dead-buttons.mjs",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run lint:contract && npm run lint:tr && npm run lint:i18n && npm run lint:errors && npm run lint:paths && npm run lint:password && npm run lint:buttons && npm run typecheck && npm run test && npm run test:dates && npm run test:dialogs && npm run test:privacy && npm run build && npm run smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dates": "node scripts/check-dates.mjs",
    "test:dialogs": "node scripts/check-dialogs.mjs",
    "test:privacy": "node scripts/check-sentry-privacy.mjs",
    "smoke": "node scripts/smoke-render.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^24.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
